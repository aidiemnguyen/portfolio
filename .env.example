# Copy to .env.local and paste your key (never commit .env.local):
#   cp .env.example .env.local
#
# Get a key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional — default is Haiku 4.5 (cheaper). Use Sonnet for higher quality:
# VOICE_MODEL=claude-haiku-4-5-20251001
# VOICE_MODEL=claude-sonnet-4-20250514

# PostHog — events proxy via /ingest (vercel.json + next.config rewrites → EU Cloud)
# Vercel: POSTHOG_PROJECT_TOKEN only; api_host is same-origin /ingest at runtime.
# Project token: https://eu.posthog.com/settings/project
POSTHOG_PROJECT_TOKEN=
# Set true to send events from localhost (dev only; do not set on Vercel production)
POSTHOG_ENABLE_ON_LOCALHOST=
